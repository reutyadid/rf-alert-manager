# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_DB=rfalerts
POSTGRES_USER=rfalerts
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://rfalerts:change-me@postgres:5432/rfalerts

# --- Broker ---
REDIS_URL=redis://redis:6379/0
CONSUMER_GROUP=alert-service

# --- Rules ---
RULES_FILE=/app/config/rules.yaml

# --- Alert logic ---
FREQ_TOLERANCE_MHZ=0.1
DEFAULT_MAX_GAP_S=3
ALLOWED_LATENESS_S=30
IDLE_TIMEOUT_S=30
SWEEP_INTERVAL_S=5
# Shared with alert-service: timestamps further ahead of the server clock are rejected/dropped
MAX_CLOCK_SKEW_S=60

# --- Ingest ---
MAX_BATCH_SIZE=1000

# --- Deploy ---
IMAGE_TAG=local

# --- Logging ---
LOG_LEVEL=INFO

# --- Observability ---
# Grafana login: admin / this password. On the VM it is generated on deploy (infra/env-sync.sh).
GRAFANA_ADMIN_PASSWORD=change-me-grafana
